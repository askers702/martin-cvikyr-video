---
// Portfolio Component (Editorial Elegance)
const portfolioItems = [
  { 
    title: "Svatební klip", 
    category: "Svatební video", 
    youtubeId: "bgeBnafrxUo" 
  },
  { 
    title: "Tereza & Michal", 
    category: "Zkrácené svatební video", 
    youtubeId: "Gz46PPxW2R4" 
  },
  { 
    title: "Apartmány Arnika", 
    category: "Nemovitosti", 
    youtubeId: "zgm8dy1qCkI" 
  },
  { 
    title: "Nadhled & Atmosféra", 
    category: "Dronové záběry", 
    youtubeId: "Q10mHEweoU8" 
  }
];
---

<section id="portfolio" class="section portfolio-section">
  <div class="container">
    <div class="section-header text-center fade-in">
      <span class="label">Portfolio</span>
      <h2>Ochutnávky z naší tvorby</h2>
      <div class="divider"></div>
    </div>

    <div class="portfolio-grid">
      {portfolioItems.map((item, i) => (
        <div class="portfolio-item fade-in" style={`animation-delay: ${0.2 * i}s`}>
          <div class="video-frame">
            <iframe 
              src={`https://www.youtube.com/embed/${item.youtubeId}?rel=0&showinfo=0`}
              title={item.title}
              frameborder="0" 
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
              allowfullscreen
              loading="lazy"
            ></iframe>
          </div>
          <div class="item-meta">
            <h3>{item.title}</h3>
            <span class="category">{item.category}</span>
          </div>
        </div>
      ))}
    </div>
    
    <div class="text-center fade-in" style="margin-top: 4rem;">
        <a href="#kontakt" class="btn btn-outline">Mám zájem o video</a>
    </div>
  </div>
</section>

<style>
  .portfolio-section {
    background-color: var(--color-surface);
  }

  .section-header {
    margin-bottom: 4rem;
  }

  .label {
    font-family: var(--font-sans);
    text-transform: uppercase;
    letter-spacing: 2px;
    font-size: 0.8rem;
    color: var(--color-primary);
    display: block;
    margin-bottom: 1rem;
  }

  .section-header h2 {
    font-size: 2.8rem;
    margin-bottom: 1.5rem;
  }

  .divider {
    width: 40px;
    height: 1px;
    background-color: var(--color-primary);
    margin: 0 auto;
  }

  .portfolio-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: 3rem;
  }

  .portfolio-item {
    width: 100%;
  }

  .video-frame {
    width: 100%;
    aspect-ratio: 16/9;
    border-radius: 6px;
    position: relative;
    overflow: hidden;
    background: var(--color-surface-light);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    transition: box-shadow var(--transition-normal), transform var(--transition-normal);
  }

  .portfolio-item:hover .video-frame {
    box-shadow: 0 8px 35px rgba(0, 0, 0, 0.15);
    transform: translateY(-4px);
  }

  .video-frame iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: none;
  }

  .item-meta {
    margin-top: 1.5rem;
    text-align: center;
  }

  .item-meta h3 {
    font-family: var(--font-serif);
    font-size: 1.4rem;
    margin-bottom: 0.3rem;
  }

  .category {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    font-family: var(--font-sans);
  }
</style>
